{
  "functions": {
    "api/tiny-sync.js": {
      "maxDuration": 60
    },
    "api/caixa-regras-bulk.js": {
      "maxDuration": 60
    },
    "api/caixa-auto-teste.js": {
      "maxDuration": 60
    },
    "api/caixa-auto-executar.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/limpeza", "destination": "/limpeza.html" },
    { "source": "/limpeza/motorista", "destination": "/limpeza-motorista.html" }
